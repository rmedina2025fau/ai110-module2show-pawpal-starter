classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +get_pet(name) Pet
        +all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +task_count() int
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +str pet_name
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +tasks_for(day) list~Task~
        +todays_schedule(day) list~Task~
        +format_schedule(tasks) str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads tasks from
